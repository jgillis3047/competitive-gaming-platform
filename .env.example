# Copy to `.env` for local development (optional if app.json extra is set).
# Never commit `.env` — it is gitignored.

# Optional: force Metro host when auto-detect picks the wrong adapter (VPN/WSL).
# REACT_NATIVE_PACKAGER_HOSTNAME=192.168.1.160

EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Supabase Edge Function secrets (set via Dashboard or CLI — not in .env for production)
# OPENAI_API_KEY=sk-...
# OPENAI_VISION_MODEL=gpt-4o-mini
# SHOT_TRACKER_URL=http://localhost:8000
# EXPO_PUBLIC_SUPPORT_EMAIL=support@example.com
# EXPO_PUBLIC_SENTRY_DSN=
# EXPO_PUBLIC_PROJECT_ID=
