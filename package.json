{
  "name": "arena",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "scripts": {
    "copy-assets": "powershell -ExecutionPolicy Bypass -File ./scripts/copy-assets.ps1",
    "fetch:words": "node ./scripts/fetch-words-en.mjs",
    "import:osm": "node --env-file=.env ./scripts/import-osm-places.mjs",
    "import:osm:launch-cities": "node --env-file=.env ./scripts/import-osm-places.mjs --city las-vegas --city los-angeles --city phoenix",
    "backfill:court-photos": "node --env-file=.env ./scripts/backfill-court-reference-photos.mjs",
    "backfill:court-photos:dry": "node --env-file=.env ./scripts/backfill-court-reference-photos.mjs --dry-run --limit 15",
    "deploy:stripe": "npx supabase functions deploy create-checkout-session && npx supabase functions deploy stripe-webhook",
    "deploy:functions": "npx supabase functions deploy create-checkout-session && npx supabase functions deploy stripe-webhook && npx supabase functions deploy delete-account && npx supabase functions deploy create-notification && npx supabase functions deploy send-push && npx supabase functions deploy create-payment-intent && npx supabase functions deploy expire-open-challenges && npx supabase functions deploy ai-review-match && npx supabase functions deploy analyze-shooting-session && npx supabase functions deploy ai-review-golf",
    "start": "node ./scripts/start-dev.mjs",
    "start:clear": "node ./scripts/start-dev.mjs -- -c",
    "start:tunnel": "node ./scripts/start-dev.mjs --tunnel",
    "start:lan": "node ./scripts/start-dev.mjs",
    "start:go": "node ./scripts/start-dev.mjs --go",
    "start:localhost": "expo start --localhost",
    "firewall:metro": "powershell -ExecutionPolicy Bypass -File ./scripts/allow-metro-firewall.ps1",
    "build:dev:android": "eas build --profile development --platform android",
    "build:dev:ios": "eas build --profile development --platform ios",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "node ./scripts/start-dev.mjs --android",
    "android:run": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@kingstinct/react-native-healthkit": "^14.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.9.1",
    "@react-navigation/native": "^7.1.8",
    "@sentry/react-native": "~7.2.0",
    "@stripe/stripe-react-native": "0.50.3",
    "@supabase/supabase-js": "^2.86.2",
    "babel-preset-expo": "~54.0.10",
    "chess.js": "^1.4.0",
    "expo": "~54.0.35",
    "expo-asset": "~12.0.13",
    "expo-av": "~16.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.21",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-router": "~6.0.24",
    "expo-secure-store": "^15.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-web-browser": "~15.0.11",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.35.9",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-vision-camera": "^5.0.11",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "react-native-worklets-core": "^1.6.3",
    "zustand": "^5.0.9"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
